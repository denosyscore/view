{
  "name": "denosyscore/view",
  "description": "View engine, directives, forms, and value objects",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "denosyscore/contracts": "^0.20"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\View\\": "src/View/",
      "Denosys\\View\\Form\\": "src/Form/",
      "Denosys\\View\\ValueObjects\\": "src/ValueObjects/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Denosys\\View\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.20.x-dev"
    }
  }
}
